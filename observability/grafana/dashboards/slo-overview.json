{
  "uid": "slo-overview",
  "title": "checkout-api — SLO Overview",
  "tags": ["slo", "sre"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Error budget remaining (30d, availability)",
      "description": "100% means the full 0.1% budget is intact. Below 0% the SLO is already missed for this window.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -0.25,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(increase(http_requests_total{status=~\"5..\"}[30d])) / sum(increase(http_requests_total[30d]))) / 0.001)",
          "legendFormat": "budget left"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Availability burn rate (multiples of budget)",
      "description": "1 = exactly on budget. The dashed page thresholds are 14.4x (1h) and 6x (6h).",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "fillOpacity": 5, "lineWidth": 2 }
        }
      },
      "targets": [
        { "refId": "A", "expr": "sli:availability:error_ratio_rate5m / 0.001", "legendFormat": "5m" },
        { "refId": "B", "expr": "sli:availability:error_ratio_rate1h / 0.001", "legendFormat": "1h" },
        { "refId": "C", "expr": "sli:availability:error_ratio_rate6h / 0.001", "legendFormat": "6h" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency SLI — share of requests slower than 300ms",
      "description": "Budget is 1%. Read off the le=0.3 histogram bucket, so this is exact, not an interpolated quantile.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        { "refId": "A", "expr": "sli:latency:slow_ratio_rate5m", "legendFormat": "5m" },
        { "refId": "B", "expr": "sli:latency:slow_ratio_rate1h", "legendFormat": "1h" }
      ]
    },
    {
      "type": "heatmap",
      "title": "Latency distribution",
      "description": "Histogram buckets straight from the app. Watch the band above 300ms grow when latency is injected.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(http_request_duration_seconds_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
